[Unit]
Description=Gathyr FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/services/Gathyr/Backend
ExecStart=/services/Gathyr/Backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --no-access-log
Restart=always
RestartSec=5
StandardOutput=append:/services/Gathyr/deploy/backend.log
StandardError=append:/services/Gathyr/deploy/backend.log

[Install]
WantedBy=multi-user.target
